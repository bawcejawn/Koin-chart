{
  "targets": {
    "release": {
      "outFile": "./build/release/pool.wasm",
      "textFile": "./build/release/pool.wat",
      "sourceMap": true,
      "optimizeLevel": 3,
      "shrinkLevel": 0,
      "converge": false,
      "noAssert": false,
      "use": ["BUILD_FOR_TESTING=0"]
    }
