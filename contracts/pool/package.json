{
  "name": "koin-chart-pool",
  "version": "0.1.0",
  "private": true,
  "description": "Owner-created AMM pools on Koinos with a fixed per-pool fee (max 3%) and a 10% owner share.",
  "scripts": {
    "precompile": "koinos-precompiler-as .",
    "asbuild:release": "asc build/index.ts --config asconfig.json --target release",
    "build": "npm run precompile && npm run asbuild:release",
    "test": "asp --config as-pect.config.js --as-config asconfig.test.json --no-logo assembly/__tests__/pool.spec.ts"
  },
  "devDependencies": {
    "@as-covers/core": "^0.4.2",
    "@as-pect/cli": "^8.1.0",
    "@koinos/mock-vm": "1.3.0",
    "@koinos/sdk-as": "^1.5.1",
    "@roamin/protoc": "^2.4.0",
    "as-proto": "npm:@koinos/as-proto@1.0.1",
    "assemblyscript": "0.27.29",
    "koinos-precompiler-as": "^1.7.2"
  }
}
